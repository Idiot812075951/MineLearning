able(Position) fx "User.DissolveOriginWS" origin) (Niagara|SetNiagaraVariable(Float) fx "User.DissolveRadius" dissolve) (Niagara|SetNiagaraVariable(Float) fx "User.SpawnRate" rate) (Niagara|SetNiagaraVariable(Float) fx "User.ParticleSpeed" (Variables|RadiantDissolve|GetRadiantParticleSpeed)) (Niagara|SetNiagaraVariable(Float) fx "User.InwardDepth" (Variables|RadiantDissolve|GetRadiantParticleInwardDepth)) (Niagara|SetNiagaraVariable(Float) fx "User.EffectDuration" duration)))